prime q = (1 << 16) + 1; // Modulus
const message: Vector<u32, 16> = [72, 101, 108, 108, 111, 44, 32, 119, 111, 114, 108, 100, 33, 10, 0, 0];

def main() {
    var message_ntt = sr_NTT(message, q);            // forward NTT with default root of unity and ordering
    var message_ntt_intt = sr_iNTT(message_ntt, q);  // inverse NTT with default root of unity and ordering
    write(message);
    write(message_ntt_intt);
}
